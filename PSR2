        "import cv2\n",
        "import numpy as np\n",
        "\n",
        "def variational_retinex(img, lambda_param=0.1, sigma=30):\n",
        "    \"\"\"\n",
        "    Apply a variational-based Retinex enhancement with halo reduction.\n",
        "\n",
        "    :param img: Input image (BGR format).\n",
        "    :param lambda_param: Regularization parameter to control the strength of illumination smoothing.\n",
        "    :param sigma: Standard deviation for the Gaussian filter used in the illumination estimation.\n",
        "    :return: Enhanced image after applying Retinex theory with halo reduction.\n",
        "    \"\"\"\n",
        "\n",
        "    # Convert to float32 for precision\n",
        "    img_float = np.float32(img) / 255.0\n",
        "\n",
        "    # Estimate the illumination component using a Gaussian filter\n",
        "    illumination = cv2.GaussianBlur(img_float, (0, 0), sigma)\n",
        "\n",
        "    # Compute the reflectance component\n",
        "    reflectance = img_float / (illumination + 1e-6)\n",
        "\n",
        "    # Normalize the reflectance for better visualization\n",
        "    reflectance = np.clip(reflectance, 0, 1)\n",
        "\n",
        "    # Convert back to 8-bit format for display\n",
        "    enhanced_img = np.uint8(reflectance * 255)\n",
        "\n",
        "    return enhanced_img\n",
        "\n",
        "def reduce_halo_artifacts(img, alpha=0.3, beta=0.5, sigma_s=30, sigma_r=0.4):\n",
        "    \"\"\"\n",
        "    Perform halo reduction using edge-preserving filters.\n",
        "\n",
        "    :param img: Input image (BGR format).\n",
        "    :param alpha: Weight of the original image.\n",
        "    :param beta: Weight of the enhanced image.\n",
        "    :param sigma_s: Spatial sigma for the bilateral filter.\n",
        "    :param sigma_r: Range sigma for the bilateral filter.\n",
        "    :return: Image with reduced halo artifacts.\n",
        "    \"\"\"\n",
        "\n",
        "    # Convert to float32 for precision\n",
        "    img_float = np.float32(img) / 255.0\n",
        "\n",
        "    # Apply a bilateral filter for edge-preserving smoothing\n",
        "    smoothed_img = cv2.bilateralFilter(img_float, d=0, sigmaColor=sigma_r, sigmaSpace=sigma_s)\n",
        "\n",
        "    # Combine the original and the smoothed images\n",
        "    output_img = alpha * img_float + beta * smoothed_img\n",
        "\n",
        "    # Clip values to valid range and convert back to 8-bit format\n",
        "    output_img = np.clip(output_img, 0, 1)\n",
        "    output_img = np.uint8(output_img * 255)\n",
        "\n",
        "    return output_img\n",
        "\n",
        "\n",
        "# Main function to perform Retinex enhancement with halo reduction\n",
        "def retinex_with_halo_reduction(image):\n",
